# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/multi_courier
# Optional: overrides the database name embedded in MONGODB_URI
# MONGODB_DB_NAME=multi_courier

# ---------------------------------------------------------------------------
# Bulk processing
# ---------------------------------------------------------------------------
BULK_MAX_ORDERS=100
# How many orders in a batch are sent to couriers at the same time.
BULK_WORKER_CONCURRENCY=10
BULK_WORKER_POLL_INTERVAL_MS=500
# Lease held on a claimed job; a crashed worker's job is reclaimed after this.
BULK_JOB_VISIBILITY_TIMEOUT_MS=120000
BULK_JOB_MAX_ATTEMPTS=3
# true  -> the API process also runs the queue worker (handy for local/demo)
# false -> run `npm run start:worker` separately (recommended in production)
RUN_WORKER_IN_API_PROCESS=true

# ---------------------------------------------------------------------------
# Courier defaults (apply to every adapter unless overridden)
# ---------------------------------------------------------------------------
COURIER_HTTP_TIMEOUT_MS=15000
COURIER_RETRY_MAX_ATTEMPTS=3
COURIER_RETRY_BASE_DELAY_MS=300
COURIER_RETRY_MAX_DELAY_MS=5000
COURIER_RETRY_JITTER=true

# ---------------------------------------------------------------------------
# Courier: UrbaneBolt
# Credentials come from the UrbaneBolt integration team. The values below are
# the UAT sandbox credentials published in the assignment's Postman collection.
# ---------------------------------------------------------------------------
URBANEBOLT_ENABLED=true
URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_USERNAME=replace-me
URBANEBOLT_PASSWORD=replace-me
URBANEBOLT_CUSTOMER_CODE=replace-me
URBANEBOLT_DEFAULT_SERVICE_TYPE=SDD
# Refresh the bearer token this many seconds before its stated expiry.
URBANEBOLT_TOKEN_REFRESH_SKEW_S=300

# ---------------------------------------------------------------------------
# Courier: Mock (bonus adapter; proves the pluggable design)
# ---------------------------------------------------------------------------
MOCK_COURIER_ENABLED=true
MOCK_COURIER_LATENCY_MS=0
# Any shipment addressed to this pincode is rejected, for exercising failure paths.
MOCK_COURIER_FAIL_PINCODE=000000
